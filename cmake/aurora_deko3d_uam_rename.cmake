# aleks2 (deko3d P1): uam's own Mesa (mesa-imported, an old GLSL frontend and nv50_ir) and the NVK driver
# the same NRO links (Mesa 26, libvulkan.a) define many of the same symbols. Every global symbol uamlib
# defines that the other archive also defines is renamed inside uamlib (definitions and uamlib's own
# references alike), so each Mesa keeps its own code. uamlib's interface (uam_api.h, namespace uam) does
# not clash and keeps its names.
#   cmake -DUAM=<libuamlib.a> -DOTHER=<libvulkan.a> -DNM=<nm> -DOBJCOPY=<objcopy> -DOUT=<map file> -P ...
execute_process(COMMAND "${NM}" -g --defined-only --format=posix "${UAM}" OUTPUT_VARIABLE _uam RESULT_VARIABLE _r1)
execute_process(COMMAND "${NM}" -g --defined-only --format=posix "${OTHER}" OUTPUT_VARIABLE _other RESULT_VARIABLE _r2)
if(NOT _r1 EQUAL 0 OR NOT _r2 EQUAL 0)
  message(FATAL_ERROR "aurora_deko3d_uam_rename: nm failed (${_r1}, ${_r2})")
endif()
function(_defined_names text out)
  string(REGEX MATCHALL "\n[^ \n]+ [A-Za-z] " _m "\n${text}")
  set(_names "")
  foreach(_e IN LISTS _m)
    string(REGEX REPLACE "^\n([^ ]+) [A-Za-z] $" "\\1" _n "${_e}")
    list(APPEND _names "${_n}")
  endforeach()
  list(REMOVE_DUPLICATES _names)
  set(${out} "${_names}" PARENT_SCOPE)
endfunction()
_defined_names("${_uam}" _uamNames)
_defined_names("${_other}" _otherNames)
set(_map "")
set(_count 0)
foreach(_n IN LISTS _uamNames)
  list(FIND _otherNames "${_n}" _at)
  if(NOT _at EQUAL -1)
    string(APPEND _map "${_n} aleks2_uam_${_n}\n")
    math(EXPR _count "${_count} + 1")
  endif()
endforeach()
file(WRITE "${OUT}" "${_map}")
if(_count GREATER 0)
  execute_process(COMMAND "${OBJCOPY}" "--redefine-syms=${OUT}" "${UAM}" RESULT_VARIABLE _r3)
  if(NOT _r3 EQUAL 0)
    message(FATAL_ERROR "aurora_deko3d_uam_rename: objcopy failed (${_r3})")
  endif()
endif()
message(STATUS "aurora_deko3d_uam_rename: ${_count} symbols of uamlib renamed (clash with ${OTHER})")
